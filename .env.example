# Copy to .env for local use:  cp .env.example .env
# Load it with:                 uv run --env-file .env uvicorn app.main:app --reload
# On Azure, set these as App Service "Application settings" instead (never commit .env).

# Python logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Not used yet. A production webhook should compare this with the clientState
# value you chose when creating the Graph subscription (see README).
# CLIENT_STATE=change-me
